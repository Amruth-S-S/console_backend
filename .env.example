MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<appName>
DB_NAME=appdb
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# First admin, seeded on startup if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin
CORS_ORIGINS=*
# Gmail SMTP account that sends booking confirmation emails — EMAIL_PASSWORD
# is a Gmail "app password" (Google Account > Security > App passwords), not
# the account's login password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
COMPANY_EMAIL=company-inbox@example.com
